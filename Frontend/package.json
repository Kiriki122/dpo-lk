{
  "name": "product",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint ./src",
    "format": "prettier --write \"./src/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,css,json}\"",
    "format:check": "prettier --check \"./src/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,css,json}\"",
    "preview": "vite preview",
    "depcruise": "cross-env FULL_GRAPH=false depcruise src --output-type dot | dot -T svg > dependency-graph.svg",
    "depcruise:full": "cross-env FULL_GRAPH=true depcruise src --output-type dot | dot -T svg > dependency-graph.full.svg"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@tanstack/react-query": "^5.90.16",
    "@types/lodash.debounce": "^4.0.9",
    "axios": "^1.13.2",
    "lodash.debounce": "^4.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "react-router": "^7.13.0",
    "validator": "^13.15.23",
    "zod": "^4.1.12",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^5.0.4",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
